@echo off
:: 한글 깨짐 방지 코드페이지 설정
chcp 65001 >nul
cls

echo ===================================================
echo   🚀 GIT AUTOMATION TOOL (Pare IDE)               
echo ===================================================
echo.

:: 1. git add . 자동 실행
echo  [1/3] 📂 변경된 소스코드를 스테이징 영역에 추가합니다...
git init
git remote add origin https://github.com/Paresthesia-1010/Pare-IDE
git add .
echo        ✔️ 완료되었습니다.
echo.

:: 2. 커밋 메시지 입력 받기
echo ===================================================
echo  [2/3] 💬 커밋 메시지를 입력해주세요.
echo        (예: feat: Pare IDE v1.0.0 및 자동 업데이트 시스템 구축)
echo ===================================================
set /p msg=" ➔ 메시지 입력: "

:: 메시지 입력 안 했을 경우 예외 처리
if "%msg%"=="" (
    echo.
    echo  ❌ 커밋 메시지가 입력되지 않아 기본 메시지로 대체합니다.
    set msg="update: 소스코드 수정"
)

echo.
echo  [진행] 💾 깃 커밋을 진행합니다...
git commit -m "%msg%"
echo        ✔️ 완료되었습니다.
echo.

:: 3. 푸시 여부 확인
echo ===================================================
echo  [3/3] 🌐 원격 저장소(GitHub)로 푸시하시겠습니까?
echo ===================================================
set /p push_choice=" ➔ 푸시하려면 'Y'를 입력하세요 (Y/N): "

if /i "%push_choice%"=="Y" (
    echo.
    echo  [진행] 📤 GitHub로 소스코드를 전송하는 중...
    git push -m master main --force
    echo.
    echo ===================================================
    echo   🎉 모든 작업이 성공적으로 완료되었습니다!
    echo ===================================================
) else (
    echo.
    echo ===================================================
    echo   🛑 푸시가 취소되었습니다. (로컬 커밋까지만 완료됨)
    echo ===================================================
)

echo.
pause
